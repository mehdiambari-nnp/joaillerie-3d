{
  "name": "ring-configurator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurateur 3D de bijoux : import FBX, matériaux temps réel, AR et essayage sur la main",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "postinstall": "node scripts/copy-wasm.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:all": "npm run build && firebase deploy",
    "dev:local": "vite --host --mode local",
    "build:local": "vite build --mode local"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "firebase-tools": "^15.33.0",
    "playwright": "1.64.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@google/model-viewer": "4.4.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "eruda": "3.4.3",
    "firebase": "^13.0.0",
    "lz-string": "1.5.0",
    "meshoptimizer": "1.3.0",
    "qrcode": "1.5.4",
    "three": "0.183.2",
    "three-mesh-bvh": "0.9.16"
  }
}
